# Versions of unpackers used by NZBGet.
# Binaries are published in the nzbgetcom/7zip and nzbgetcom/unrar repositories.
# The GitHub tag is "v" + the value.
#
# ZIP7_VERSION / UNRAR_VERSION track the current releases.
# ZIP7_MACOS_X64_VERSION (frozen) - 7-Zip release for macOS x64 / Mojave compatibility.
# UNRAR6_VERSION (frozen) - latest UnRAR 6 release.
# UNRAR_WIN32_VERSION (frozen) - latest UnRAR release for 32-bit Windows.
#
# UNRAR_SRC_VERSION / UNRAR6_SRC_VERSION - rarlab source versions of the same releases
# (used by the Docker build only; they differ from the release versions).
ZIP7_VERSION=26.03
ZIP7_MACOS_X64_VERSION=25.01
UNRAR_VERSION=7.23
UNRAR_SRC_VERSION=7.2.7
UNRAR6_VERSION=6.24
UNRAR6_SRC_VERSION=6.2.12
UNRAR_WIN32_VERSION=7.01
