if(DEFINED ENV{CMAKE_SYSTEM_NAME})
	if (NOT CMAKE_SYSTEM_NAME)
		set(CMAKE_SYSTEM_NAME $ENV{CMAKE_SYSTEM_NAME})
	endif()
else()
	if (CMAKE_SYSTEM_NAME)
		set(ENV{CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_NAME})
	else()
		set(CMAKE_SYSTEM_NAME Linux)
	endif()
endif()
set(CMAKE_SYSTEM_PROCESSOR ${ARCH})

set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

# On Android (Bionic libc), pthreads functions are built directly into libc.so.
# When CMAKE_TRY_COMPILE_TARGET_TYPE is STATIC_LIBRARY, FindThreads cannot test linking
# and erroneously falls back to -lpthreads. Prevent this by pre-initializing thread flags.
if(ANDROID OR NZBGET_BUILD_PLATFORM STREQUAL "android" OR TOOLCHAIN_PREFIX MATCHES "android" OR CMAKE_SYSTEM_NAME STREQUAL "Android")
	set(CMAKE_THREAD_LIBS_INIT "" CACHE STRING "" FORCE)
	set(CMAKE_HAVE_THREADS_LIBRARY 1 CACHE BOOL "" FORCE)
	set(CMAKE_USE_WIN32_THREADS_INIT 0 CACHE BOOL "" FORCE)
	set(CMAKE_USE_PTHREADS_INIT 1 CACHE BOOL "" FORCE)
	set(THREADS_PREFER_PTHREAD_FLAG ON CACHE BOOL "" FORCE)
	set(CMAKE_HAVE_PTHREADS_CREATE 0 CACHE BOOL "" FORCE)
	set(Threads_FOUND TRUE CACHE BOOL "" FORCE)
endif()

if("${CMAKE_SYSTEM_NAME}" STREQUAL "FreeBSD")
	set(CMAKE_C_COMPILER            clang-14)
	set(CMAKE_CXX_COMPILER          clang++-14)
	set(CMAKE_LINKER                lld-14)
	set(CMAKE_CXX_COMPILER_TARGET   x86_64-pc-freebsd)
	set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld-14 -no-pie")
else()
	if(NOT COMPILER)
		set(COMPILER "gcc" CACHE STRING "")
	endif()

	if("${COMPILER}" STREQUAL "gcc")
		set(C_COMPILER   "gcc")
		set(CXX_COMPILER "g++")
	else()
		set(C_COMPILER   ${COMPILER})
		set(CXX_COMPILER ${COMPILER}++)
	endif()
	set(CMAKE_AR           ${TOOLCHAIN_PREFIX}-ar)
	set(CMAKE_ASM_COMPILER ${TOOLCHAIN_PREFIX}-as)
	set(CMAKE_C_COMPILER   ${TOOLCHAIN_PREFIX}-${C_COMPILER})
	set(CMAKE_CXX_COMPILER ${TOOLCHAIN_PREFIX}-${CXX_COMPILER})
	set(CMAKE_LINKER       ${TOOLCHAIN_PREFIX}-ld)
	set(CMAKE_OBJCOPY      ${TOOLCHAIN_PREFIX}-objcopy)
	set(CMAKE_RANLIB       ${TOOLCHAIN_PREFIX}-ranlib)
	set(CMAKE_SIZE         ${TOOLCHAIN_PREFIX}-size)
	set(CMAKE_STRIP        ${TOOLCHAIN_PREFIX}-strip)
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

# Android Bionic libc includes pthreads directly in libc.so (no separate libpthread.so)
if(TOOLCHAIN_PREFIX MATCHES "android" OR CMAKE_SYSTEM_NAME STREQUAL "Android")
	set(CMAKE_THREAD_LIBS_INIT "" CACHE STRING "" FORCE)
	set(CMAKE_USE_PTHREADS_INIT 1 CACHE BOOL "" FORCE)
	set(Threads_FOUND TRUE CACHE BOOL "" FORCE)
endif()
