---
CompileFlags:
  Remove:
    - "-fstack-clash-protection"
    - "-fcf-protection*"
    - "-mbranch-protection*"
    - "-fno-fat-lto-objects"
    - "/MP*"
    - "/guard:cf"
    - "/diagnostics:*"
    - "/Zc:inline"

Index:
  Background: Build
  StandardLibrary: Yes

Completion:
  AllScopes: Yes
  HeaderInsertion: Never

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    FastCheckFilter: Loose
