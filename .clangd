---
CompileFlags:
  Remove:
    - "-fstack-clash-protection"
    - "-fcf-protection*"
    - "-mbranch-protection*"
    - "-fno-fat-lto-objects"
    - "/MP*"
    - "/guard:cf"
    - "/diagnostics:*"
    - "/Zc:inline"
  # Show every compiler warning for any build type, not only for Debug.
  Add:
    - "-Weverything"
    - "-Wno-c++98-compat"
    - "-Wno-c++98-compat-pedantic"
    - "-Wno-unused-parameter"

Index:
  Background: Build
  StandardLibrary: Yes

Completion:
  AllScopes: Yes
  HeaderInsertion: Never

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    FastCheckFilter: Loose
